# ==============================================================================
# ShopPilot Environment Configuration
# Copy to .env for local development. Never commit real secrets to git.
# ==============================================================================

# --- Google Cloud & Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Optional: For Google AI Studio local dev (set GOOGLE_GENAI_USE_VERTEXAI=FALSE)
# GOOGLE_API_KEY=

# --- Model Configuration ---
SHOPPILOT_MODEL=gemini-2.5-flash
SHOPPILOT_COMPLEX_MODEL=gemini-2.5-pro

# --- Runtime & Server ---
APP_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Security ---
# In production on Cloud Run, keep REQUIRE_AUTH=true (enforced via Cloud Run IAM / Bearer token).
REQUIRE_AUTH=false
# Optional shared API key for non-IAM local/staging testing (store in Secret Manager in prod)
# SHOPPILOT_API_KEY=

# --- Context & Memory Backends ---
# Options: memory | sqlite:///./shoppilot_sessions.db | postgresql+asyncpg://... | vertex
SESSION_SERVICE_URI=memory
# Options: memory | vertex
MEMORY_SERVICE_TYPE=memory
# Required only when MEMORY_SERVICE_TYPE=vertex
# VERTEX_AGENT_ENGINE_ID=

# --- Observability & Tracing ---
ENABLE_CLOUD_TRACE=false
ENABLE_CONSOLE_TRACE=false
LOG_LEVEL=INFO
SERVICE_NAME=shoppilot
SERVICE_VERSION=1.0.0
